#!/usr/bin/env python3
"""
ablate.py — ablation study on FOLD 0, producing the real Table II numbers.

Leaves the validated full model UNTOUCHED. Builds three variants by wrapping the
existing modules (no in-place edits):

  FULL            : the shipped model (evaluate its saved best.pt)  [reference]
  -local-residual : train a variant whose velocity net uses ONLY the SSM refiner
                    (LocalHead output zeroed). Tests the local-fidelity finding.
  v-prediction    : train a variant with the noise-MIXING velocity target
                    (z_tau=(1-tau)z_a + tau z_b, u=z_b-z_a). Tests the leakage/collapse
                    finding. Expected to collapse -> we cap it short and report it.
  -calibration    : NO training. Re-report FULL's metrics WITHOUT temperature (raw).

Each trained variant uses the SAME fold-0 recipe (batch, LR schedule, var-warmup,
EMA, steps) as train.py, differing ONLY in the ablated component.

Run:  CUDA_VISIBLE_DEVICES=0 python ablate.py --which local     # ~2-4h
      CUDA_VISIBLE_DEVICES=0 python ablate.py --which vpred      # short (collapses)
      CUDA_VISIBLE_DEVICES=0 python ablate.py --which report     # eval all + Table II
Order: run 'local' and 'vpred' (training) first, then 'report'.
"""
from __future__ import annotations
import os, sys, math, copy, json, time, argparse
import numpy as np, torch, torch.nn as nn, torch.nn.functional as F
from torch.utils.data import DataLoader, Subset
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
_P1="/media/image522/8TPan1/image522/Ernest_Tri-Mamba-Net/NBPY-FILES/u101prjt"
if _P1 not in sys.path: sys.path.insert(0,_P1)
os.environ.setdefault("PYTORCH_CUDA_ALLOC_CONF","expandable_segments:True")

from cached_pair_dataset import CachedPairDataset, patient_kfold
from flow import sample_tau, noise_interpolate, HeteroscedasticFMLoss, generate, interpolate
from velocity_net_v2 import VelocityNetV2
from vqgan3d import VQGAN3D
from seg_head_img import ImgSegUNet
import calibration as CAL
import metrics as M

CACHE="/media/image522/8TPan1/image522/Ernest_Tri-Mamba-Net/NBPY-FILES/Bio-SSM-Flow/latent_cache_lumiere"
BASE ="/media/image522/8TPan1/image522/Ernest_Tri-Mamba-Net/NBPY-FILES/Bio-SSM-Flow/runs"
VQGAN="/media/image522/8TPan1/image522/Ernest_Tri-Mamba-Net/NBPY-FILES/u101prjt/data/UR_SSM_DIFF_DATASETS/UR_SSM_Diff_Outputs/checkpoints/vqgan_r4/best_vqgan.pt"
SEG  ="/media/image522/8TPan1/image522/Ernest_Tri-Mamba-Net/NBPY-FILES/Bio-SSM-Flow/runs/seghead_img_fold0/imgseg_best.pt"
DEV="cuda:0"; FOLD=0; K=5; BATCH=16; LR=2e-4; WARMUP=500; VARWARM=2000; EMA=0.999
R=32; STEPS=20; TUMOR=(1,3); DIL=3

def lr_at(s,total):
    if s<WARMUP: return LR*s/max(1,WARMUP)
    p=(s-WARMUP)/max(1,total-WARMUP); return LR*0.5*(1+math.cos(math.pi*min(p,1.0)))
def collate(b):
    return {k:(torch.stack([x[k] for x in b]) if torch.is_tensor(b[0][k]) else [x[k] for x in b]) for k in b[0]}
class EMAw:
    def __init__(s,m,d): s.d=d; s.sh=copy.deepcopy(m.state_dict())
    @torch.no_grad()
    def upd(s,m):
        for k,v in m.state_dict().items():
            s.sh[k].mul_(s.d).add_(v,alpha=1-s.d) if v.dtype.is_floating_point else s.sh[k].copy_(v)
    def to(s,m): m.load_state_dict(s.sh,strict=True)

def make_net():
    return VelocityNetV2(latent_dim=4,d_h=128,stage_depths=(2,2,4),bottleneck_depth=4,use_checkpoint=True).to(DEV)

def zero_local_head(net):
    """Ablation: disable the per-voxel LocalHead so only the SSM refiner drives output."""
    for p in net.local.parameters():
        p.requires_grad_(False); p.data.zero_()
    # force SSM contribution on from the start (refine_scale would otherwise stay ~0)
    with torch.no_grad(): net.refine_scale.fill_(1.0)
    net.refine_scale.requires_grad_(True)
    print("[ablate] LocalHead zeroed + frozen; refine_scale=1.0 (SSM-only velocity)")

# ---------------------------------------------------------------- training
def train_variant(which, steps_cap=None):
    torch.manual_seed(0)
    ds=CachedPairDataset(CACHE); tr,_=list(patient_kfold(ds,k=K))[FOLD]
    dl=DataLoader(Subset(ds,tr),BATCH,shuffle=True,num_workers=4,collate_fn=collate,drop_last=True)
    net=make_net(); net.set_week(None)
    if which=="local": zero_local_head(net)
    opt=torch.optim.AdamW([p for p in net.parameters() if p.requires_grad],lr=LR,weight_decay=1e-4)
    ema=EMAw(net,EMA); loss_fn=HeteroscedasticFMLoss()
    out=f"{BASE}/ablate_{which}"; os.makedirs(out,exist_ok=True)
    epochs=300; total=epochs*len(dl); step=0; t0=time.time()
    print(f"[ablate:{which}] total_steps={total}"+(f" (capped at {steps_cap})" if steps_cap else ""))
    net.train()
    for ep in range(epochs):
        for b in dl:
            z_a=b["z_a"].to(DEV); z_b=b["z_b"].to(DEV); dt=b["dt"].to(DEV); net.set_week(None)
            for g in opt.param_groups: g["lr"]=lr_at(step,total)
            with torch.amp.autocast(DEV,dtype=torch.bfloat16):
                if which=="vpred":
                    # NOISE-MIXING velocity parameterisation (the collapse-prone one)
                    tau=sample_tau(z_a.shape[0],DEV)
                    z_tau,u=interpolate(z_a,z_b,tau)        # z_tau=(1-tau)z_a+tau z_b ; u=z_b-z_a
                    v,logvar=net(z_tau,tau,z_a,dt)
                    if step<VARWARM: loss=F.mse_loss(v.float(),u.float()); logs={"vel_mse":float(loss.detach())}
                    else: loss,_,logs=loss_fn(u,v.float(),logvar.float())
                else:
                    # x1 / noise->z_b transport (as in the full model), local head ablated
                    tau=sample_tau(z_a.shape[0],DEV); eps=torch.randn_like(z_b)
                    z_tau,u=noise_interpolate(z_b,tau,eps)
                    v,logvar=net(z_tau,tau,z_a,dt)
                    if step<VARWARM: loss=F.mse_loss(v.float(),u.float()); logs={"vel_mse":float(loss.detach())}
                    else: loss,_,logs=loss_fn(u,v.float(),logvar.float())
            opt.zero_grad(set_to_none=True); loss.backward()
            torch.nn.utils.clip_grad_norm_([p for p in net.parameters() if p.requires_grad],1.0)
            opt.step(); ema.upd(net); step+=1
            if step%100==0:
                print(f"  [{which}] step {step}/{total} loss {float(loss):.4f} vel_mse {logs.get('vel_mse',float('nan')):.4f} {(time.time()-t0)/step*100:.0f}s/100")
            if steps_cap and step>=steps_cap:
                torch.save({"net":net.state_dict(),"ema":ema.sh,"step":step,"which":which},f"{out}/best.pt")
                print(f"[ablate:{which}] capped at {step}; saved."); return
        # save each epoch end
        torch.save({"net":net.state_dict(),"ema":ema.sh,"step":step,"which":which},f"{out}/best.pt")
    print(f"[ablate:{which}] done in {(time.time()-t0)/3600:.2f}h")

# ---------------------------------------------------------------- eval
@torch.no_grad()
def eval_variant(which, transport="x1", use_calib=True):
    """Evaluate a saved variant (or the FULL model) on fold-0 val. Returns metric dict."""
    ds=CachedPairDataset(CACHE); _,val=list(patient_kfold(ds,k=K))[FOLD]
    vq=VQGAN3D(in_channels=4,latent_dim=4,downsample_factor=4)
    vq.load_state_dict(torch.load(VQGAN,map_location="cpu",weights_only=False).get("gen"),strict=False); vq.eval().to(DEV)
    seg=ImgSegUNet().to(DEV); seg.load_state_dict(torch.load(SEG,map_location=DEV,weights_only=False)["net"]); seg.eval()
    for p in list(vq.parameters())+list(seg.parameters()): p.requires_grad_(False)
    ckpt = f"{BASE}/forecast_fold0/best.pt" if which=="full" else f"{BASE}/ablate_{which}/best.pt"
    st=torch.load(ckpt,map_location=DEV,weights_only=False)
    net=make_net(); net.load_state_dict(st.get("ema",st.get("net"))); net.eval(); net.set_week(None)

    def roi_lat(z_a,z_b):
        def tum(z):
            lab=seg(vq.decode(z)).argmax(1,keepdim=True); return sum((lab==c) for c in TUMOR)>0
        r=(tum(z_a)|tum(z_b)).float(); r=F.max_pool3d(r,2*DIL+1,1,DIL)>0.5
        return F.avg_pool3d(r.float(),4)>0.1
    def rmse(a,b,m): mm=m.expand_as(a); return F.mse_loss(a[mm],b[mm]).item() if mm.sum()>0 else np.nan

    crps=[]; regimp=[]; picp=[]; euc=[]
    per_s=[]; per_y=[]
    for i in val:
        s=ds[i]; z_a=s["z_a"].unsqueeze(0).to(DEV); z_b=s["z_b"].unsqueeze(0).to(DEV); dt=s["dt"].view(1).to(DEV)
        if transport=="vpred":
            # deterministic-ish: integrate the learned velocity from z_a (no noise prior)
            samp=[]
            for _ in range(R):
                z=z_a.clone()
                for m_ in range(STEPS):
                    v,_=net(z, torch.full((1,),m_/STEPS,device=DEV), z_a, dt); z=z+(1/STEPS)*v
                samp.append(z)
            samp=torch.stack(samp,0)
        else:
            samp=generate(lambda z,t,za,d: net(z,t,za,d),z_a,dt,steps=STEPS,n_samples=R)
        if use_calib:
            per_s.append(samp); per_y.append(z_b)
        mean=samp.mean(0); roi=roi_lat(z_a,z_b)
        crps.append(M.ensemble_crps(samp,z_b))
        rc=rmse(z_a,z_b,roi); rm=rmse(mean,z_b,roi)
        if not np.isnan(rc): regimp.append(100*(1-rm/rc))
        s2=samp.var(0).mean(1).reshape(1,-1).clamp_min(1e-8)
        u=M.uncertainty_block(mean,z_b,s2); euc.append(u["err_unc_corr"])
    res={"crps":float(np.mean(crps)),"region_imp":float(np.nanmean(regimp)),"err_unc":float(np.mean(euc))}
    if use_calib and per_s:
        Tfit=CAL.fit_temperature(per_s,per_y,verbose=False)
        res["picp90_cal"]=float(np.mean([CAL._picp(CAL.calibrate(x,Tfit),y,0.9) for x,y in zip(per_s,per_y)]))
        res["picp90_raw"]=float(np.mean([CAL._picp(x,y,0.9) for x,y in zip(per_s,per_y)]))
        res["T"]=float(Tfit)
    return res

def report():
    print("\n[ablate] evaluating all variants on fold 0 ...")
    rows={}
    rows["Full model"]        = eval_variant("full",  transport="x1",   use_calib=True)
    if os.path.exists(f"{BASE}/ablate_local/best.pt"):
        rows["- local-residual"] = eval_variant("local", transport="x1",   use_calib=True)
    if os.path.exists(f"{BASE}/ablate_vpred/best.pt"):
        rows["v-prediction"]     = eval_variant("vpred", transport="vpred",use_calib=True)
    # -calibration: FULL model, report WITHOUT temperature (raw coverage)
    full=rows["Full model"]
    rows["- calibration"] = {"crps":full["crps"],"region_imp":full["region_imp"],
                             "err_unc":full["err_unc"],"picp90_cal":full.get("picp90_raw"),"T":1.0}
    print("\n================= TABLE II (ablation, fold 0) =================")
    print(f"{'Variant':<18}{'CRPS':>8}{'Reg.imp%':>10}{'PICP@90':>9}{'ErrUnc':>8}")
    for k,r in rows.items():
        print(f"{k:<18}{r['crps']:>8.3f}{r['region_imp']:>10.1f}"
              f"{r.get('picp90_cal',float('nan')):>9.3f}{r['err_unc']:>8.3f}")
    print("="*62)
    json.dump(rows,open(f"{BASE}/ablation_table.json","w"),indent=2)
    print(f"[saved] ablation_table.json  -> fill Table II with these REAL numbers")

if __name__=="__main__":
    ap=argparse.ArgumentParser(); ap.add_argument("--which",required=True,
        choices=["local","vpred","report"])
    a=ap.parse_args()
    if a.which=="local": train_variant("local")
    elif a.which=="vpred": train_variant("vpred", steps_cap=3000)   # collapses fast; cap short
    else: report()
